# Production reverse proxy (M16). Rendered by the nginx image at start-up:
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf with envsubst of DEFINED variables only
# (${ROOT_DOMAIN}, ${BOOKING_ROOT}); nginx variables such as $host stay untouched.
#
#   console.${ROOT_DOMAIN}          Platform Console + /api/v1/auth, /api/v1/platform (IP allowlist also in the API)
#   app.${ROOT_DOMAIN}              Business CRM     + /api/v1/auth, /api/v1/business
#   api.${ROOT_DOMAIN}              API only, /health/*
#   <slug>.${BOOKING_ROOT}          Booking Web      + /api/v1/public (same origin)
#   verified custom domains         Booking Web (certificate per domain, see RUNBOOK §TLS)
#   anything else                   404
#
# Certificates (Let's Encrypt, see deploy/production/RUNBOOK.md):
#   /etc/letsencrypt/live/${ROOT_DOMAIN}/          console, app, api (HTTP-01)
#   /etc/letsencrypt/live/wildcard.${BOOKING_ROOT}/ *.${BOOKING_ROOT} (DNS-01, wildcard)

# writes on the public site (bookings, cancel, unsubscribe) are limited per IP; reads are not (empty key)
map $request_method $public_write_key {
    default "";
    POST $binary_remote_addr;
    PUT $binary_remote_addr;
    PATCH $binary_remote_addr;
    DELETE $binary_remote_addr;
}
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $public_write_key zone=public_write:10m rate=30r/m;

upstream api_upstream {
    server api:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
ssl_stapling on;
ssl_stapling_verify on;
resolver 1.1.1.1 8.8.8.8 valid=300s;
resolver_timeout 5s;
server_tokens off;
client_max_body_size 5m;

# ========================================================
# HTTP (80): ACME challenge + health, everything else -> HTTPS
# ========================================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /healthz {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ========================================================
# Platform Console
# ========================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name console.${ROOT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;

    root /var/www/platform-console;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';" always;

    location /api/v1/auth/ {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location /api/v1/platform/ {
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location /api/ {
        default_type application/json;
        return 404 '{"code":"ROUTE_NOT_AVAILABLE_ON_HOST"}';
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ========================================================
# Business CRM
# ========================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.${ROOT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;

    root /var/www/business-crm;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';" always;

    location /api/v1/auth/ {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location /api/v1/business/ {
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location /api/ {
        default_type application/json;
        return 404 '{"code":"ROUTE_NOT_AVAILABLE_ON_HOST"}';
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ========================================================
# API host: integrations and monitoring
# ========================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${ROOT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /health/ {
        access_log off;
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location ~ ^/api/v1/(auth|business|platform)/ {
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location / {
        default_type application/json;
        return 404 '{"code":"NOT_FOUND"}';
    }
}

# ========================================================
# Booking Web: <slug>.${BOOKING_ROOT}
# ========================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name "~^(?<tenant_subdomain>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.${BOOKING_ROOT_REGEX}$";

    ssl_certificate /etc/letsencrypt/live/wildcard.${BOOKING_ROOT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.${BOOKING_ROOT}/privkey.pem;

    root /var/www/booking-web;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # which company: decided by the API from the Host header (tenant_domains), never from the URL
    location /api/v1/public/ {
        limit_req zone=public_write burst=10 nodelay;
        include /etc/nginx/snippets/proxy_api.conf;
    }
    location /api/ {
        default_type application/json;
        return 404 '{"code":"ROUTE_NOT_AVAILABLE_ON_HOST"}';
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ========================================================
# Default: unmapped hosts
# ========================================================
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;

    location / {
        default_type text/plain;
        return 404 "Domain not mapped\n";
    }
}
