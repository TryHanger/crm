# Production environment (M16). Copy to .env.production next to this file, fill in, `chmod 600`.
# Never commit the filled file. Generate secrets: python scripts/generate_staging_secrets.py (32+ chars each).

RELEASE_TAG=2026.11.0

# --- domains (DNS: see RUNBOOK §DNS) ---
ROOT_DOMAIN=example.kz
BOOKING_ROOT=book.example.kz
# the same as BOOKING_ROOT with escaped dots, used in the nginx server_name regex
BOOKING_ROOT_REGEX=book\.example\.kz

# --- PostgreSQL ---
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=
POSTGRES_DB=saas_crm
DB_USER=crm_app_user
DB_PASSWORD=

# --- application ---
JWT_SECRET_KEY=
API_WORKERS=2
# office IPs allowed to open the Platform Console (comma separated); empty is refused in production
PLATFORM_IP_ALLOWLIST=
INITIAL_PLATFORM_OWNER_EMAIL=
INITIAL_PLATFORM_OWNER_PASSWORD=
INITIAL_PLATFORM_OWNER_NAME=Platform Administrator

# --- email (M15): a real provider with SPF/DKIM/DMARC on the sender domain ---
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl ; "none" is refused in production
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.kz
EMAIL_NOTIFICATIONS_ENABLED=true
PLATFORM_DAILY_EMAIL_LIMIT_MAX=2000

# --- backups (M16): AES-256-GCM key (64 hex) is kept OFF this host as well, see RUNBOOK §Backups ---
BACKUP_ENCRYPTION_KEY=
OFFSITE_S3_ENDPOINT=https://
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_REGION=us-east-1
OFFSITE_S3_PREFIX=crm/

# --- monitoring (M16): scripts/monitor_check.py ---
MONITOR_HOSTS=app.example.kz,console.example.kz,api.example.kz,demo.book.example.kz
