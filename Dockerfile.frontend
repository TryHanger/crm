# Multi-Stage Dockerfile for Frontend Applications (Booking Web, Business CRM, Platform Console)

# ==========================================
# Stage 1: Build all workspaces
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/

RUN npm ci && npm run build --workspaces

# ==========================================
# Stage 2: Production Non-Root Asset Sync Runner
# ==========================================
FROM nginx:1.27-alpine AS runner

RUN mkdir -p /opt/static/booking-web \
             /opt/static/business-crm \
             /opt/static/platform-console \
             /var/www/booking-web \
             /var/www/business-crm \
             /var/www/platform-console && \
    chown -R 101:101 /opt/static /var/www && \
    chmod -R 755 /opt/static /var/www

COPY --from=builder --chown=101:101 /build/apps/booking-web/dist /opt/static/booking-web
COPY --from=builder --chown=101:101 /build/apps/business-crm/dist /opt/static/business-crm
COPY --from=builder --chown=101:101 /build/apps/platform-console/dist /opt/static/platform-console

# Enforce non-root execution (UID 101 is nginx user in alpine)
USER 101:101

# Healthcheck verifies all three frontend index.html files exist and are non-empty
HEALTHCHECK --interval=2s --timeout=3s --retries=10 --start-period=1s \
  CMD test -s /var/www/booking-web/index.html && \
      test -s /var/www/business-crm/index.html && \
      test -s /var/www/platform-console/index.html || exit 1

CMD ["sh", "-c", "cp -a /opt/static/booking-web/. /var/www/booking-web/ && cp -a /opt/static/business-crm/. /var/www/business-crm/ && cp -a /opt/static/platform-console/. /var/www/platform-console/ && echo 'Frontend assets synchronized successfully' && sleep infinity"]
