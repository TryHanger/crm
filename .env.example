# Database Settings
DATABASE_URL=postgresql+asyncpg://crm_app_user:crm_app_secret@127.0.0.1:5432/saas_crm
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/saas_crm

# JWT Security
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform Settings
PLATFORM_ROOT_DOMAIN=platform.example.kz
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://crm.platform.example.kz"]
