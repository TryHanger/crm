# ==============================================================================
# SaaS Online Booking & CRM Platform - Staging Environment Configuration Template
# COPY THIS FILE TO .env.staging AND FILL IN SECURE RANDOM VALUES BEFORE STARTUP.
# NEVER COMMIT ACTUAL SECRETS TO GIT.
# ==============================================================================

ENVIRONMENT=staging
DEBUG=false
ENABLE_DEMO_SEED=false

# ------------------------------------------------------------------------------
# PostgreSQL Credentials (Strong passwords >= 16 characters required)
# ------------------------------------------------------------------------------
POSTGRES_DB=saas_crm_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-admin-password-at-least-16-chars!
DB_USER=crm_app_user
DB_PASSWORD=replace-with-strong-runtime-password-at-least-16-chars!

# ------------------------------------------------------------------------------
# Security & Cryptographic Tokens (Minimum 32 characters required)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-cryptographic-random-secret-key-at-least-32-chars!

# ------------------------------------------------------------------------------
# Initial Platform Administrator Bootstrap (Created on clean DB initialization)
# ------------------------------------------------------------------------------
INITIAL_PLATFORM_OWNER_EMAIL=admin@staging.crm.internal
INITIAL_PLATFORM_OWNER_PASSWORD=replace-with-secure-initial-owner-password-at-least-16-chars!
INITIAL_PLATFORM_OWNER_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# Network Security & IP Allowlist (Mandatory in Staging/Production)
# Comma-separated IPv4/IPv6 addresses or CIDR ranges authorized to access Platform Console.
# ------------------------------------------------------------------------------
PLATFORM_IP_ALLOWLIST=127.0.0.1,::1,10.0.0.0/8,192.168.1.0/24

# ------------------------------------------------------------------------------
# Domain Routing Configurations
# ------------------------------------------------------------------------------
BOOKING_DOMAIN_SUFFIX=.book.staging.crm.internal
CRM_DOMAIN=app.staging.crm.internal
PLATFORM_DOMAIN=console.staging.crm.internal

# ------------------------------------------------------------------------------
# SMTP Configuration (Optional: if empty, transparent manual delivery is audited)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@staging.crm.internal
